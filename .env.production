# URL API untuk build produksi.
#
# Nilai WAJIB absolut. Nilai relatif seperti "/api" terlihat benar tapi salah di
# produksi: domain kustom (ilmanainitiative.com) tidak mem-proxy /api ke
# backend, sehingga setiap request API berakhir 404. Vite menyuntik variabel
# VITE_* ke dalam kode saat build, jadi nilai di sini selalu menang atas
# fallback yang ada di src/utils/api.js, dan file ini ikut ter-commit ke repo
# sehingga build siapa pun di Tim akan mengikutinya.
#
# Host di bawah harus sama dengan yang diizinkan CORS backend
# (CLIENT_ORIGINS di backend/server.js) dan oleh connect-src pada CSP frontend.
VITE_API_URL=https://azure-barracuda-788858.hostingersite.com/api
